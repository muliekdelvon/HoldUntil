# ==========================================
# HoldUntil Production Environment Config
# ==========================================

# Server Configuration (Coolify / Container)
PORT=8000

# Application Mode
DEBUG=False
SIMULATION_MODE=false # false = Real M-Pesa transactions; true = Mock simulation

# Database Configuration
# Option A (SQLite with persistent Docker volume):
DATABASE_URL=sqlite:////app/data/holduntil.db
# Option B (Coolify PostgreSQL database):
# DATABASE_URL=postgresql://username:password@postgres-host:5432/holduntil


# ==========================================
# Safaricom Daraja (M-Pesa) Production Keys
# ==========================================
# Target Environment: 'production'
DARAJA_ENV=production

# Production Daraja App Keys (from developer.safaricom.co.ke)
DARAJA_CONSUMER_KEY=your_production_consumer_key
DARAJA_CONSUMER_SECRET=your_production_consumer_secret

# Lipa Na M-Pesa Online (STK Push)
# For Paybill: DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
# For Buy Goods / Till: DARAJA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_SHORTCODE=your_production_paybill_or_shortcode
DARAJA_BUY_GOODS_TILL= # optional if using Buy Goods till with separate store shortcode
DARAJA_PASSKEY=your_production_passkey

# Webhook Callback URLs (Must be public HTTPS domain)
DARAJA_CALLBACK_URL=https://your-domain.com/api/webhook/daraja/callback
DARAJA_B2C_CALLBACK_URL=https://your-domain.com/api/webhook/daraja/b2c_callback

# B2C Payouts & Refunds (Automated escrow disbursements)
DARAJA_B2C_SHORTCODE=your_b2c_shortcode
DARAJA_INITIATOR_NAME=your_b2c_initiator_username
DARAJA_SECURITY_CREDENTIAL=your_encrypted_b2c_security_credential

# ==========================================
# Meta WhatsApp Business Cloud API
# ==========================================
META_API_VERSION=v18.0
META_VERIFY_TOKEN=holduntil_verify_token_123
META_ACCESS_TOKEN=your_meta_system_user_token
META_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
BOT_WHATSAPP_NUMBER=254107560742

# ==========================================
# AI Moderator (Gemini)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key
